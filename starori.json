from datetime import datetime
import json
import requests


def transform_jtv_data(json_url):
  # 1. Fetch JSON from the link
  try:
    response = requests.get(json_url)
    response.raise_for_status()
    data = response.json()
  except Exception as e:
    print(f"Error fetching data: {e}")
    return None

  channels = data.get("channels", [])
  total_channels = len(channels)
  successful_results = []

  # 2. Transform each channel into the target format
  for ch in channels:
    channel_id = ch.get("id")
    channel_name = ch.get("name")
    stream_url = ch.get("stream_url", "")
    cookie = ch.get("cookie", "")

    # Combine stream_url and cookie into final_url
    final_url = f"{stream_url}?{cookie}" if cookie else stream_url

    channel_result = {
        "channel_id": channel_id,
        "channel_name": channel_name,
        "status": "success",
        "http_code": 200,
        "final_url": final_url,
    }
    successful_results.append(channel_result)

  # 3. Construct the final output structure
  output_data = {
      "source_url": json_url,
      "total_channels": total_channels,
      "successful_channels": total_channels,  # Assuming all fetched are successful
      "failed_channels": 0,
      "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
      "successful_results": successful_results,
  }

  return output_data


if __name__ == "__main__":
  url = "https://sportlink-tv10.pages.dev/jtvplus.json"
  transformed_json = transform_jtv_data(url)

  if transformed_json:
    # Print formatted JSON output
    print(json.dumps(transformed_json, indent=4))

